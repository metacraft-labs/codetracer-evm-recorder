#!/usr/bin/env sh
# reprobuild hook dispatcher protocol=2
# Dispatches preserved user hooks and Reprobuild-managed pre-push logic.
set -eu
set +x
REPROBUILD_CAPTURED_CAPABILITY=${REPROBUILD_INTERNAL_HOOK_CAPABILITY:-}
REPROBUILD_CAPTURED_INTERNAL_CONTEXT=${REPROBUILD_INTERNAL_HOOK_CONTEXT:-}
unset REPROBUILD_INTERNAL_HOOK_CAPABILITY REPROBUILD_HOOK_ACTIVE REPROBUILD_HOOK_DISPATCH_PROTOCOL REPROBUILD_INTERNAL_HOOK_CONTEXT

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LOCAL_HOOK="$HOOK_DIR/pre-push.repro-local"
MANAGED_HOOK="$HOOK_DIR/pre-push.repro-managed"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
if [ -n "${REPROBUILD_REPRO:-}" ] && [ -x "$REPROBUILD_REPRO" ]; then
  REPRO_REMEDY_CMD=$REPROBUILD_REPRO
elif command -v repro >/dev/null 2>&1; then
  REPRO_REMEDY_CMD=$(command -v repro)
else
  REPRO_REMEDY_CMD=repro
fi

PRECOMMIT_LEGACY="$HOOK_DIR/pre-push.legacy"
case "$0" in
  *"/pre-push.legacy" | "pre-push.legacy") RUNNING_AS_LEGACY=1 ;;
  *) RUNNING_AS_LEGACY=0 ;;
esac
if [ "$RUNNING_AS_LEGACY" = 1 ]; then
  echo "repro hooks: pre-push is running as pre-push.legacy: another hook manager replaced the dispatcher. Restore it with '$REPRO_REMEDY_CMD hooks ensure --vcs $REPO_ROOT'" >&2
elif [ -f "$PRECOMMIT_LEGACY" ] && grep -q 'reprobuild hook dispatcher' "$PRECOMMIT_LEGACY" 2>/dev/null; then
  rm -f "$PRECOMMIT_LEGACY"
fi

run_local_hook() {
  [ -x "$LOCAL_HOOK" ] || return 0
  if [ "$RUNNING_AS_LEGACY" = 1 ] && grep -Eq '^# File generated by (pre-commit|prek):' "$LOCAL_HOOK" 2>/dev/null; then
    return 0
  fi
  (unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; exec "$LOCAL_HOOK" "$@")
}

TMP_FILE=$(mktemp "${TMPDIR:-/tmp}/reprobuild-pre-push.XXXXXX")
chmod 600 "$TMP_FILE"
trap 'rm -f "$TMP_FILE"' EXIT HUP INT TERM
cat > "$TMP_FILE"
run_local_hook "$@" < "$TMP_FILE" || exit $?
if [ ! -x "$MANAGED_HOOK" ] || ! grep -q 'reprobuild managed pre-push hook protocol=2' "$MANAGED_HOOK" 2>/dev/null; then
  echo "repro hooks: hook protocol mismatch; run '$REPRO_REMEDY_CMD hooks ensure --vcs $REPO_ROOT' and retry" >&2
  exit 1
fi
(unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; export REPROBUILD_HOOK_DISPATCH_PROTOCOL=2 REPROBUILD_INTERNAL_HOOK_CAPABILITY="$REPROBUILD_CAPTURED_CAPABILITY"; exec "$MANAGED_HOOK" "$@") < "$TMP_FILE" || exit $?
exit 0
