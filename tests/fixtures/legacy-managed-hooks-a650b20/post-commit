#!/usr/bin/env sh
# reprobuild hook dispatcher protocol=2
# Dispatches preserved user hooks and Reprobuild-managed post-commit logic.
set -eu
set +x
REPROBUILD_CAPTURED_CAPABILITY=${REPROBUILD_INTERNAL_HOOK_CAPABILITY:-}
REPROBUILD_CAPTURED_INTERNAL_CONTEXT=${REPROBUILD_INTERNAL_HOOK_CONTEXT:-}
unset REPROBUILD_INTERNAL_HOOK_CAPABILITY REPROBUILD_HOOK_ACTIVE REPROBUILD_HOOK_DISPATCH_PROTOCOL REPROBUILD_INTERNAL_HOOK_CONTEXT

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LOCAL_HOOK="$HOOK_DIR/post-commit.repro-local"
MANAGED_HOOK="$HOOK_DIR/post-commit.repro-managed"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
if [ -n "${REPROBUILD_REPRO:-}" ] && [ -x "$REPROBUILD_REPRO" ]; then
  REPRO_REMEDY_CMD=$REPROBUILD_REPRO
elif command -v repro >/dev/null 2>&1; then
  REPRO_REMEDY_CMD=$(command -v repro)
else
  REPRO_REMEDY_CMD=repro
fi

PRECOMMIT_LEGACY="$HOOK_DIR/post-commit.legacy"
case "$0" in
  *"/post-commit.legacy" | "post-commit.legacy") RUNNING_AS_LEGACY=1 ;;
  *) RUNNING_AS_LEGACY=0 ;;
esac
if [ "$RUNNING_AS_LEGACY" = 1 ]; then
  echo "repro hooks: post-commit is running as post-commit.legacy: another hook manager replaced the dispatcher. Restore it with '$REPRO_REMEDY_CMD hooks ensure --vcs $REPO_ROOT'" >&2
elif [ -f "$PRECOMMIT_LEGACY" ] && grep -q 'reprobuild hook dispatcher' "$PRECOMMIT_LEGACY" 2>/dev/null; then
  rm -f "$PRECOMMIT_LEGACY"
fi

run_local_hook() {
  [ -x "$LOCAL_HOOK" ] || return 0
  if [ "$RUNNING_AS_LEGACY" = 1 ] && grep -Eq '^# File generated by (pre-commit|prek):' "$LOCAL_HOOK" 2>/dev/null; then
    return 0
  fi
  (unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; exec "$LOCAL_HOOK" "$@")
}

run_local_hook "$@" || exit $?
if [ -x "$MANAGED_HOOK" ]; then (unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; export REPROBUILD_INTERNAL_HOOK_CONTEXT="$REPROBUILD_CAPTURED_INTERNAL_CONTEXT"; exec "$MANAGED_HOOK" "$@") || exit $?; fi
exit 0
