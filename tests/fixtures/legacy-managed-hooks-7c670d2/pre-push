#!/usr/bin/env sh
# reprobuild hook dispatcher protocol=2
# Dispatches preserved user hooks and Reprobuild-managed pre-push logic.
set -eu
set +x
REPROBUILD_CAPTURED_CAPABILITY=${REPROBUILD_INTERNAL_HOOK_CAPABILITY:-}
REPROBUILD_CAPTURED_INTERNAL_CONTEXT=${REPROBUILD_INTERNAL_HOOK_CONTEXT:-}
unset REPROBUILD_INTERNAL_HOOK_CAPABILITY REPROBUILD_HOOK_ACTIVE REPROBUILD_HOOK_DISPATCH_PROTOCOL REPROBUILD_INTERNAL_HOOK_CONTEXT

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LOCAL_HOOK="$HOOK_DIR/pre-push.repro-local"
MANAGED_HOOK="$HOOK_DIR/pre-push.repro-managed"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
if [ -n "${REPROBUILD_REPRO:-}" ] && [ -x "$REPROBUILD_REPRO" ]; then
  REPRO_REMEDY_CMD=$REPROBUILD_REPRO
elif command -v repro >/dev/null 2>&1; then
  REPRO_REMEDY_CMD=$(command -v repro)
else
  REPRO_REMEDY_CMD=repro
fi

PRECOMMIT_LEGACY="$HOOK_DIR/pre-push.legacy"
case "$0" in
  *"/pre-push.legacy" | "pre-push.legacy") RUNNING_AS_LEGACY=1 ;;
  *) RUNNING_AS_LEGACY=0 ;;
esac
if [ "$RUNNING_AS_LEGACY" = 1 ]; then
  echo "repro hooks: pre-push is running as pre-push.legacy: another hook manager replaced the dispatcher. Restore it with '$REPRO_REMEDY_CMD hooks ensure --vcs $REPO_ROOT'" >&2
elif [ -f "$PRECOMMIT_LEGACY" ] && grep -q 'reprobuild hook dispatcher' "$PRECOMMIT_LEGACY" 2>/dev/null; then
  rm -f "$PRECOMMIT_LEGACY"
fi

local_hook_missing_program() {
  # One pass, so the candidates come in line order: the `#!` interpreter, then
  # each `exec` line (a double-quoted path, or a bare one). The two `exec`
  # patterns cannot match the same line.
  sed -n -E \
    -e '1s/^#![[:space:]]*(\/[^[:space:]]*).*$/interpreter \1/p' \
    -e 's/^exec[[:space:]]+"(\/[^"$`\\]*)"([[:space:];&|<>)]|$).*$/exec \1/p' \
    -e 's/^exec[[:space:]]+(\/[^][[:space:];&|<>()"'"'"'$`\\*?{}~]*)([[:space:];&|<>)]|$).*$/exec \1/p' \
    "$LOCAL_HOOK" 2>/dev/null |
  while IFS=' ' read -r LOCAL_HOOK_KIND LOCAL_HOOK_PROGRAM; do
    [ ! -x "$LOCAL_HOOK_PROGRAM" ] || continue
    # An `exec` target counts only when exactly one non-comment line names it
    # as a whole path (not as a prefix of a longer one), so a path the body
    # tests first, or an `exec` line that repeats its own path, is judged by
    # lines and not by substrings.
    if [ "$LOCAL_HOOK_KIND" = exec ] &&
        [ "$(LOCAL_HOOK_PROGRAM=$LOCAL_HOOK_PROGRAM awk '
          BEGIN { p = ENVIRON["LOCAL_HOOK_PROGRAM"]; n = 0 }
          /^[ \t]*#/ { next }
          {
            for (pos = 1; (i = index(substr($0, pos), p)) > 0; pos = st + 1) {
              st = pos + i - 1
              pre = (st > 1) ? substr($0, st - 1, 1) : ""
              post = substr($0, st + length(p), 1)
              # Plain index() against literal sets, not bracket expressions:
              # ranges and escapes in brackets differ between awks and locales.
              if ((pre == "" || index("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./+-", pre) == 0) &&
                  (post == "" || index(" \t\r;&|<>()\"`\047", post) > 0)) {
                n++
                break
              }
            }
          }
          END { print n }' "$LOCAL_HOOK")" != 1 ]; then
      continue
    fi
    printf '%s %s\n' "$LOCAL_HOOK_KIND" "$LOCAL_HOOK_PROGRAM"
    break
  done
}

run_local_hook() {
  [ -x "$LOCAL_HOOK" ] || return 0
  if [ "$RUNNING_AS_LEGACY" = 1 ] && grep -Eq '^# File generated by (pre-commit|prek):' "$LOCAL_HOOK" 2>/dev/null; then
    return 0
  fi
  LOCAL_HOOK_RC=0
  (unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; exec "$LOCAL_HOOK" "$@") || LOCAL_HOOK_RC=$?
  case "$LOCAL_HOOK_RC" in
    126|127) LOCAL_HOOK_MISSING=$(local_hook_missing_program) ;;
    *) LOCAL_HOOK_MISSING= ;;
  esac
  if [ -n "$LOCAL_HOOK_MISSING" ]; then
    LOCAL_HOOK_KIND=${LOCAL_HOOK_MISSING%% *}
    LOCAL_HOOK_MISSING=${LOCAL_HOOK_MISSING#* }
    if [ "$LOCAL_HOOK_KIND" = interpreter ]; then
      echo "repro hooks: pre-push: the chained hook $LOCAL_HOOK cannot start: its interpreter, $LOCAL_HOOK_MISSING, does not exist or is not executable." >&2
    else
      echo "repro hooks: pre-push: the chained hook $LOCAL_HOOK failed, likely because the program it execs, $LOCAL_HOOK_MISSING, does not exist or is not executable." >&2
    fi
    case "$LOCAL_HOOK_MISSING" in
      /nix/store/*) echo "repro hooks: it is a Nix store path, and garbage collection deletes a store path that no GC root holds." >&2 ;;
    esac
    echo "repro hooks: re-enter this repository's dev shell so its hook installer writes pre-push.repro-local again, or delete $LOCAL_HOOK if nothing installs the pre-push stage any more. '$REPRO_REMEDY_CMD health' lists every such hook." >&2
  fi
  return "$LOCAL_HOOK_RC"
}

TMP_FILE=$(mktemp "${TMPDIR:-/tmp}/reprobuild-pre-push.XXXXXX")
chmod 600 "$TMP_FILE"
trap 'rm -f "$TMP_FILE"' EXIT HUP INT TERM
cat > "$TMP_FILE"
run_local_hook "$@" < "$TMP_FILE" || exit $?
if [ ! -x "$MANAGED_HOOK" ] || ! grep -q 'reprobuild managed pre-push hook protocol=2' "$MANAGED_HOOK" 2>/dev/null; then
  echo "repro hooks: hook protocol mismatch; run '$REPRO_REMEDY_CMD hooks ensure --vcs $REPO_ROOT' and retry" >&2
  exit 1
fi
(unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; export REPROBUILD_HOOK_DISPATCH_PROTOCOL=2 REPROBUILD_INTERNAL_HOOK_CAPABILITY="$REPROBUILD_CAPTURED_CAPABILITY"; exec "$MANAGED_HOOK" "$@") < "$TMP_FILE" || exit $?
exit 0
