#!/usr/bin/env sh
# reprobuild hook dispatcher protocol=2
# Dispatches preserved user hooks and Reprobuild-managed post-checkout logic.
set -eu
set +x
REPROBUILD_CAPTURED_CAPABILITY=${REPROBUILD_INTERNAL_HOOK_CAPABILITY:-}
REPROBUILD_CAPTURED_INTERNAL_CONTEXT=${REPROBUILD_INTERNAL_HOOK_CONTEXT:-}
unset REPROBUILD_INTERNAL_HOOK_CAPABILITY REPROBUILD_HOOK_ACTIVE REPROBUILD_HOOK_DISPATCH_PROTOCOL REPROBUILD_INTERNAL_HOOK_CONTEXT

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LOCAL_HOOK="$HOOK_DIR/post-checkout.repro-local"
MANAGED_HOOK="$HOOK_DIR/post-checkout.repro-managed"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
if [ -n "${REPROBUILD_REPRO:-}" ] && [ -x "$REPROBUILD_REPRO" ]; then
  REPRO_REMEDY_CMD=$REPROBUILD_REPRO
elif command -v repro >/dev/null 2>&1; then
  REPRO_REMEDY_CMD=$(command -v repro)
else
  REPRO_REMEDY_CMD=repro
fi

PRECOMMIT_LEGACY="$HOOK_DIR/post-checkout.legacy"
case "$0" in
  *"/post-checkout.legacy" | "post-checkout.legacy") RUNNING_AS_LEGACY=1 ;;
  *) RUNNING_AS_LEGACY=0 ;;
esac
if [ "$RUNNING_AS_LEGACY" = 1 ]; then
  echo "repro hooks: post-checkout is running as post-checkout.legacy: another hook manager replaced the dispatcher. Restore it with '$REPRO_REMEDY_CMD hooks ensure --vcs $REPO_ROOT'" >&2
elif [ -f "$PRECOMMIT_LEGACY" ] && grep -q 'reprobuild hook dispatcher' "$PRECOMMIT_LEGACY" 2>/dev/null; then
  rm -f "$PRECOMMIT_LEGACY"
fi

local_hook_missing_program() {
  { sed -n -E '1s/^#![[:space:]]*(\/[^[:space:]]*).*$/interpreter \1/p' "$LOCAL_HOOK"
    sed -n -E 's/^exec[[:space:]]+"(\/[^"$`\\]*)"([[:space:];&|<>)]|$).*$/exec \1/p' "$LOCAL_HOOK"
    sed -n -E 's/^exec[[:space:]]+(\/[^][[:space:];&|<>()"'"'"'$`\\*?{}~]*)([[:space:];&|<>)]|$).*$/exec \1/p' "$LOCAL_HOOK"
  } 2>/dev/null | while IFS=' ' read -r LOCAL_HOOK_KIND LOCAL_HOOK_PROGRAM; do
    [ ! -x "$LOCAL_HOOK_PROGRAM" ] || continue
    if [ "$LOCAL_HOOK_KIND" = exec ] &&
        [ "$(grep -o -F -- "$LOCAL_HOOK_PROGRAM" "$LOCAL_HOOK" | wc -l | tr -d ' ')" != 1 ]; then
      continue
    fi
    printf '%s %s\n' "$LOCAL_HOOK_KIND" "$LOCAL_HOOK_PROGRAM"
    break
  done
}

run_local_hook() {
  [ -x "$LOCAL_HOOK" ] || return 0
  if [ "$RUNNING_AS_LEGACY" = 1 ] && grep -Eq '^# File generated by (pre-commit|prek):' "$LOCAL_HOOK" 2>/dev/null; then
    return 0
  fi
  LOCAL_HOOK_RC=0
  (unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; exec "$LOCAL_HOOK" "$@") || LOCAL_HOOK_RC=$?
  case "$LOCAL_HOOK_RC" in
    126|127) LOCAL_HOOK_MISSING=$(local_hook_missing_program) ;;
    *) LOCAL_HOOK_MISSING= ;;
  esac
  if [ -n "$LOCAL_HOOK_MISSING" ]; then
    LOCAL_HOOK_KIND=${LOCAL_HOOK_MISSING%% *}
    LOCAL_HOOK_MISSING=${LOCAL_HOOK_MISSING#* }
    if [ "$LOCAL_HOOK_KIND" = interpreter ]; then
      echo "repro hooks: post-checkout: the chained hook $LOCAL_HOOK cannot start: its interpreter, $LOCAL_HOOK_MISSING, does not exist or is not executable." >&2
    else
      echo "repro hooks: post-checkout: the chained hook $LOCAL_HOOK failed, likely because the program it execs, $LOCAL_HOOK_MISSING, does not exist or is not executable." >&2
    fi
    case "$LOCAL_HOOK_MISSING" in
      /nix/store/*) echo "repro hooks: it is a Nix store path, and garbage collection deletes a store path that no GC root holds." >&2 ;;
    esac
    echo "repro hooks: re-enter this repository's dev shell so its hook installer writes post-checkout.repro-local again, or delete $LOCAL_HOOK if nothing installs the post-checkout stage any more. '$REPRO_REMEDY_CMD health' lists every such hook." >&2
  fi
  return "$LOCAL_HOOK_RC"
}

run_local_hook "$@" || exit $?
if [ -x "$MANAGED_HOOK" ]; then (unset PRE_COMMIT_RUNNING_LEGACY PREK_RUNNING_LEGACY; export REPROBUILD_INTERNAL_HOOK_CONTEXT="$REPROBUILD_CAPTURED_INTERNAL_CONTEXT"; exec "$MANAGED_HOOK" "$@") || exit $?; fi
exit 0
